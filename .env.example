# Google Analytics 4
# GA4 measurement ID (Admin > Data Streams), e.g. G-XXXXXXXXXX. Enables the
# sitewide gtag snippet and client lead events. Omit to disable GA entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret (Admin > Data Streams > Measurement
# Protocol API secrets). Server-only; used by /api/lead to record conversions.
GA_API_SECRET=

# Secret for triggering /api/indexnow (post-deploy IndexNow submission).
# Route no-ops silently when unset.
CRON_SECRET=

# Google Places API (New) — Google reviews on the site. Server-only. Both must
# be set or the reviews section is simply absent (no mock data). See
# docs/plans/google-reviews-setup-checklist.md for setup steps.
GOOGLE_PLACES_API_KEY=
# The Google Place ID of the office listing (Google Place ID Finder).
GOOGLE_PLACE_ID=
