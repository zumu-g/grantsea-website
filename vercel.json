{
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "enabled": true
  },
  "functions": {
    "src/app/api/properties/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/open-homes/route.ts": {
      "maxDuration": 60
    }
  }
}